# Placeholder values only. Copy to .env for local development. Never commit .env.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=                           # generated locally, never committed

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=food_delivery
DB_USERNAME=food_delivery
DB_PASSWORD=change_me_local_only

REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

CUSTOMER_APP_URL=http://localhost:3000
MERCHANT_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002

MAP_STYLE_URL=                    # style JSON on our PMTiles host (ADR-015); empty = placeholder
ROUTING_BASE_URL=                 # Valhalla in a later phase; empty = disabled
GEOCODING_BASE_URL=               # later phase; empty = manual pin only

DEFAULT_CURRENCY=PHP
DEFAULT_DISPLAY_TIMEZONE=Asia/Manila

FEATURE_PUBLIC_REGISTRATION=false
FEATURE_LIVE_DISPATCH=false
FEATURE_ONLINE_PAYMENTS=false
FEATURE_RIDER_TRACKING=false

# Local mail capture. The MINIO_* values are unused until ADR-012 (object storage) is decided.
MINIO_ROOT_USER=local_minio
MINIO_ROOT_PASSWORD=change_me_local_only
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025

# Laravel Boost (dev only). The API serves no pages, so the browser log route stays off.
BOOST_BROWSER_LOGS_WATCHER=false

# Host ports published by infra/compose.yaml (localhost only). Change one only
# if something on your machine already uses it, e.g. a locally installed
# PostgreSQL on 5432. Containers still talk to each other on the standard ports.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# Server-side URL the web apps use to reach the API (admin readiness check).
API_URL=http://localhost:8000

# Proxies whose X-Forwarded-For/-Proto/-Port are believed: comma-separated IPs or
# CIDR ranges of the TLS proxy in front of the API. Empty locally. Never "*".
TRUSTED_PROXIES=

# Sessions. Set SESSION_SECURE_COOKIE=true wherever the API is served over HTTPS.
SESSION_SECURE_COOKIE=false
HASH_DRIVER=argon2id

# Optional, local only: set a passphrase (10+ characters) and run seed-demo to get
# demo-owner@example.test and demo-customer@example.test. Leave empty for none.
DEMO_PASSWORD=

# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

GEO_CAPS_APPROVED=false             # set true only after a person approves the zone caps (C-13)
