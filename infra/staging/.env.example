# Staging settings (backlog E-07). Copy to .env in this directory on the server
# and fill in every CHANGE_ME. .env is git-ignored: never commit it, never paste
# it into chat or a ticket. Generate each secret on the server, for example:
#   openssl rand -hex 24                      (passwords: hex has no characters that need quoting)
#   echo "base64:$(openssl rand -base64 32)"  (APP_KEY)
# Do not use a "$" or a space in any value (Docker Compose reads this file too).
# Walk-through: docs/operations/staging-setup.md.

# ---- Release ------------------------------------------------------------
# Image tag to run, for example the short commit id. Set by the operator per deploy
# (or pass RELEASE=... on the command line).
RELEASE=CHANGE_ME_commit_id
# Where the Cloudflare Origin Certificate files origin.pem and origin.key live on the server.
CERT_DIR=/etc/hara/certs

# ---- Application (ProductionGuard checks these; see deploy.md) -----------
APP_NAME="Food Delivery"
APP_ENV=staging
APP_DEBUG=false
APP_KEY=CHANGE_ME_base64_key
APP_URL=https://staging-api.haradelivery.com
# Three distinct public https origins (ADR-011). No trailing slash.
CUSTOMER_APP_URL=https://staging.haradelivery.com
MERCHANT_APP_URL=https://staging-merchant.haradelivery.com
ADMIN_APP_URL=https://staging-admin.haradelivery.com
# Leave empty: host-only session cookie on the API host (ADR-011 "Staging domain layout").
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Must be "database": suspending a staff account and resetting two-step verification
# end the person's sessions only in the database store (StaffSuspension, StaffMfa).
# The rehearsal stack used redis, which would leave those sessions alive.
SESSION_DRIVER=database
HASH_DRIVER=argon2id
# Must be the edge network's subnet in compose.yaml. Never "*" or a /0 range.
TRUSTED_PROXIES=172.31.77.0/24
LOG_CHANNEL=stack
LOG_STACK=json
# DEMO_PASSWORD must stay UNSET here (ProductionGuard refuses to serve if it is set).
# Demo data is loaded only with the one-off command in staging-setup.md.
DEMO_PASSWORD=

# ---- Database (internal network only; never published) -------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=food_delivery
DB_USERNAME=food_delivery
DB_PASSWORD=CHANGE_ME_hex_password

# ---- Redis (internal network only; never published) ----------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_hex_password
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---- Mail ----------------------------------------------------------------
# No mail provider is chosen yet (open decision). "log" writes each message,
# including any reset link, to the API container log: acceptable on a private
# staging with synthetic accounts only. A real provider needs the api service to
# have outbound access: add the `edge` network to it in compose.yaml.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@haradelivery.com
MAIL_FROM_NAME="Food Delivery"

# ---- Features and platform -----------------------------------------------
DEFAULT_CURRENCY=PHP
FEATURE_PUBLIC_REGISTRATION=false
FEATURE_LIVE_DISPATCH=false
FEATURE_ONLINE_PAYMENTS=false
FEATURE_RIDER_TRACKING=false
# Leave empty until the PMTiles archive is hosted (ADR-015); the map then shows its placeholder.
MAP_STYLE_URL=

# ---- Web apps: build-time values (public by definition; never a secret) ----
# These are written into the browser bundle when the web images are built.
# Changing one means rebuilding the three web images.
NEXT_PUBLIC_API_URL=https://staging-api.haradelivery.com
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_APP_NAME=
